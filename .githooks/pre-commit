#!/usr/bin/env bash
# pre-commit: run the structural lint and refuse the commit on any failure.
# Enable once per clone: git config core.hooksPath .githooks
# Why a hook: twice a commit ran past failing lint because the run was piped
# into `tail`, whose exit status the commit then read (2026-10-21, 2026-10-27).
# A rule in prose did not stop the second one. Bypass knowingly: git commit -n
root=$(git rev-parse --show-toplevel) || exit 1
out=$(bash "$root/tests/lint/run.sh" 2>&1); rc=$?
if [ "$rc" -ne 0 ]; then
  printf '%s\n' "$out" | grep -E '^FAIL|issue\(s\) found' >&2
  echo "pre-commit: lint failed (exit $rc); commit refused. Full output: bash tests/lint/run.sh" >&2
  exit 1
fi
